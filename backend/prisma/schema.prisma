generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  dono_loja
  admin_master
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  papel     Papel    @default(dono_loja)
  lojaId    String?  @map("loja_id")
  loja      Loja?    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("usuarios")
}

model Loja {
  id                String   @id @default(uuid())
  nome              String
  slug              String   @unique
  telefoneWhatsapp  String   @map("telefone_whatsapp")
  logoUrl           String?  @map("logo_url")
  capaUrl           String?  @map("capa_url")
  tagline           String?
  endereco          String?
  chavePix          String?  @map("chave_pix")
  horarioAbertura   String?  @map("horario_abertura")
  horarioFechamento String?  @map("horario_fechamento")
  abertoManual      Boolean? @map("aberto_manual")
  corPrimaria       String   @default("#16A34A") @map("cor_primaria")
  corSecundaria     String   @default("#15803D") @map("cor_secundaria")
  criadoEm          DateTime @default(now()) @map("criado_em")

  usuarios       Usuario[]
  categorias     Categoria[]
  produtos       Produto[]
  pedidos        Pedido[]
  bairrosEntrega BairroEntrega[]

  @@map("lojas")
}

model Categoria {
  id     String @id @default(uuid())
  lojaId String @map("loja_id")
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome   String
  ordem  Int    @default(0)

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id          String    @id @default(uuid())
  lojaId      String    @map("loja_id")
  loja        Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  categoriaId String    @map("categoria_id")
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nome        String
  descricao   String?
  preco       Decimal   @db.Decimal(10, 2)
  fotoUrl     String?   @map("foto_url")
  disponivel  Boolean   @default(true)
  opcoes      Json?
  criadoEm    DateTime  @default(now()) @map("criado_em")

  @@map("produtos")
}

model Pedido {
  id                 String   @id @default(uuid())
  lojaId             String   @map("loja_id")
  loja               Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  numero             Int      @default(0)
  clienteNome        String   @default("") @map("cliente_nome")
  clienteTelefone    String   @map("cliente_telefone")
  itens              Json
  formaRecebimento   String   @default("retirada") @map("forma_recebimento")
  bairroEntregaId    String?  @map("bairro_entrega_id")
  bairroEntregaNome  String?  @map("bairro_entrega_nome")
  valorEntrega       Decimal  @default(0) @db.Decimal(10, 2) @map("valor_entrega")
  formaPagamento     String   @default("nao_informado") @map("forma_pagamento")
  precisaTroco       Boolean? @map("precisa_troco")
  trocoPara          Decimal? @db.Decimal(10, 2) @map("troco_para")
  tipoCartao         String?  @map("tipo_cartao")
  entregaCep         String?  @map("entrega_cep")
  entregaLogradouro  String?  @map("entrega_logradouro")
  entregaNumero      String?  @map("entrega_numero")
  entregaComplemento String?  @map("entrega_complemento")
  entregaBairro      String?  @map("entrega_bairro")
  entregaCidade      String?  @map("entrega_cidade")
  entregaEstado      String?  @map("entrega_estado")
  entregaReferencia  String?  @map("entrega_referencia")
  status             String   @default("recebido")
  total              Decimal  @db.Decimal(10, 2)
  criadoEm           DateTime @default(now()) @map("criado_em")

  @@map("pedidos")
}

model BairroEntrega {
  id           String   @id @default(uuid())
  lojaId       String   @map("loja_id")
  loja         Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nomeBairro   String   @map("nome_bairro")
  valorEntrega Decimal  @db.Decimal(10, 2) @map("valor_entrega")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("bairros_entrega")
}
