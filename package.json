{
  "name": "smartfood",
  "private": true,
  "version": "0.1.0",
  "description": "SmartFood — plataforma multiempresa de gestão comercial para food service (Smart Platform)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./backend --filter ./frontend dev",
    "build": "pnpm --filter ./backend build && pnpm --filter ./frontend build",
    "lint": "pnpm --filter ./backend lint && pnpm --filter ./frontend lint",
    "test": "pnpm --filter ./backend test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "prettier --write",
      "eslint --fix --config backend/eslint.config.js"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
