NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://smartfood:smartfood@localhost:5432/smartfood"

JWT_SECRET="troque-por-um-segredo-forte"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# E-mail transacional de recuperação de senha (Resend) — sem isso, o link
# só é logado no console em dev, nunca enviado de verdade.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Cloudflare Turnstile (protege /api/public/esqueci-senha) — sem isso, a
# verificação é PULADA em dev/teste (com aviso no console) e RECUSA a
# solicitação em produção (nunca pula silenciosamente).
TURNSTILE_SECRET_KEY=""
