# SmartFood — backend (Missão 0008, Smart Starter Kit)
# Copiar para .env antes de rodar localmente. Nunca commitar .env real (Smart Platform Architecture, Seção 13).

# Ambiente: development | staging | production (Smart Platform Architecture, Seção 2)
NODE_ENV=development

PORT=3001

# String de conexão do PostgreSQL (schema "platform" nesta missão — Missão 0006, Seção 9)
DATABASE_URL="postgresql://smartfood:smartfood@localhost:5432/smartfood?schema=platform"

# Segredo de assinatura JWT (Missão 0010, ADR-0024). Gerar um valor único por ambiente,
# nunca reutilizar entre dev/staging/production. Ex.: openssl rand -hex 32
JWT_SECRET="troque-este-valor-antes-de-rodar-em-qualquer-ambiente-real"
