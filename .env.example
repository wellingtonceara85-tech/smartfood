# SmartFood — variáveis usadas pelo docker-compose.yml na raiz do monorepo.
# Copiar para .env antes de `docker compose up`. Nunca commitar .env real.

POSTGRES_USER=smartfood
POSTGRES_PASSWORD=smartfood
POSTGRES_DB=smartfood
POSTGRES_PORT=5432

BACKEND_PORT=3001
DATABASE_URL="postgresql://smartfood:smartfood@postgres:5432/smartfood?schema=platform"

# Segredo de assinatura JWT (Missão 0010, ADR-0024). Gerar um valor único por ambiente.
JWT_SECRET="troque-este-valor-antes-de-rodar-em-qualquer-ambiente-real"

FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001"
