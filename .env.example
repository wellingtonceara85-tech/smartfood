# SmartFood — variáveis usadas pelo docker-compose.yml na raiz.
# Copiar para .env antes de `docker compose up`. Nunca commitar .env real.

POSTGRES_USER=smartfood
POSTGRES_PASSWORD=smartfood
POSTGRES_DB=smartfood
POSTGRES_PORT=5432

BACKEND_PORT=3001
DATABASE_URL="postgresql://smartfood:smartfood@postgres:5432/smartfood"
JWT_SECRET="troque-por-um-segredo-forte"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

FRONTEND_PORT=3000
VITE_API_URL="http://localhost:3001"
