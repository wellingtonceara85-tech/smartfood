generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  dono_loja
  admin_master
}

enum StatusLoja {
  ativa
  suspensa
}

enum StatusOnboarding {
  nao_iniciado
  em_andamento
  concluido
}

enum OrigemRascunho {
  planilha
  colar_texto
}

enum StatusRascunho {
  rascunho
  publicado
  descartado
}

enum OrigemSolicitacaoCardapio {
  pdf
  imagem
}

enum StatusSolicitacaoCardapio {
  recebido
  em_revisao
  aguardando_lojista
  aprovado
  concluido
}

enum CategoriaSugestao {
  cardapio
  pedidos
  financeiro
  entregas
  relatorios
  outro
}

enum StatusSugestao {
  nova
  em_analise
  planejada
  implementada
  nao_planejada
}

model Usuario {
  id                  String    @id @default(uuid())
  nome                String
  email               String    @unique
  // Nulo enquanto o usuário está "aguardando ativação" — criado pelo Admin
  // Master sem senha, até o próprio dono definir a sua via ConviteAtivacao.
  senhaHash           String?   @map("senha_hash")
  papel               Papel     @default(dono_loja)
  lojaId              String?   @map("loja_id")
  loja                Loja?     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  // Preenchido no momento em que o convite de ativação é usado (senha definida) — início do trial da loja.
  ativadoEm           DateTime? @map("ativado_em")
  // Atualizado a cada login bem-sucedido (login normal ou ativação, que já loga o dono) — única fonte de "uso recente".
  ultimoLoginEm       DateTime? @map("ultimo_login_em")
  // Última versão do aviso de novidades (ex: "2026.08.1") que este usuário já
  // viu e fechou. Comparado com a versão atual no frontend — null significa
  // "nunca viu nenhuma". Não é ligado a login/JWT de propósito, pra não mexer
  // no fluxo de autenticação: é lido/gravado por endpoints próprios.
  novidadeVersaoVista String?   @map("novidade_versao_vista")
  criadoEm            DateTime  @default(now()) @map("criado_em")

  convitesAtivacao  ConviteAtivacao[]
  recuperacoesSenha RecuperacaoSenha[]

  @@map("usuarios")
}

model ConviteAtivacao {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Só o hash do token fica no banco — o token bruto existe apenas no link
  // enviado ao lojista, nunca é persistido nem logado.
  tokenHash  String    @unique @map("token_hash")
  expiraEm   DateTime  @map("expira_em")
  usadoEm    DateTime? @map("usado_em")
  revogadoEm DateTime? @map("revogado_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")

  @@map("convites_ativacao")
}

// Recuperação de senha self-service — deliberadamente separada de
// ConviteAtivacao (nunca reaproveitada como reset de senha): mesmo formato
// de token hasheado/expira/uso único, mas tabela e fluxo próprios, pra nunca
// acoplar as duas features. Ver utils/recuperacaoSenha.ts.
model RecuperacaoSenha {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiraEm   DateTime  @map("expira_em")
  usadoEm    DateTime? @map("usado_em")
  revogadoEm DateTime? @map("revogado_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")

  @@map("recuperacoes_senha")
}

model Loja {
  id                          String     @id @default(uuid())
  nome                        String
  slug                        String     @unique
  telefoneWhatsapp            String     @map("telefone_whatsapp")
  logoUrl                     String?    @map("logo_url")
  capaUrl                     String?    @map("capa_url")
  tagline                     String?
  endereco                    String?
  chavePix                    String?    @map("chave_pix")
  // Campos legados (janela única, igual todo dia da semana) — mantidos pra
  // lojas que ainda não migraram pra agenda semanal (ver horariosFuncionamento).
  // Nunca removidos: calcularAberto() cai pra eles quando horariosFuncionamento é null.
  horarioAbertura             String?    @map("horario_abertura")
  horarioFechamento           String?    @map("horario_fechamento")
  abertoManual                Boolean?   @map("aberto_manual")
  // Agenda semanal (substitui horarioAbertura/horarioFechamento quando presente):
  // array de 7 entradas { diaSemana: 0-6 (0=domingo, igual Date.getDay()),
  // ativo: boolean, faixas: [{ abertura, fechamento }] } — ver
  // backend/src/utils/horario.ts. null = loja ainda não migrou; nesse caso os
  // campos legados acima continuam valendo, sem nenhuma mudança de comportamento.
  horariosFuncionamento       Json?      @map("horarios_funcionamento")
  corPrimaria                 String     @default("#16A34A") @map("cor_primaria")
  corSecundaria               String     @default("#15803D") @map("cor_secundaria")
  aceitaAgendamento           Boolean    @default(false) @map("aceita_agendamento")
  antecedenciaMinimaMinutos   Int        @default(0) @map("antecedencia_minima_minutos")
  status                      StatusLoja @default(ativa)
  suspensaEm                  DateTime?  @map("suspensa_em")
  // Início/fim do trial de 30 dias — preenchidos quando o dono ativa a conta (não na criação da loja).
  // trialFimEm pode ser prorrogado pelo Admin Master; trialInicioEm nunca muda depois de setado.
  trialInicioEm               DateTime?  @map("trial_inicio_em")
  trialFimEm                  DateTime?  @map("trial_fim_em")
  // Origem (loja) para cálculo de distância aproximada até o cliente — só
  // preenchida via botão "Usar minha localização" (Geolocation API do
  // navegador) no painel, nunca por geocoding automático do endereço em texto.
  latitude                    Float?     @map("latitude")
  longitude                   Float?     @map("longitude")
  // Liga a segunda estratégia de taxa de entrega (por distância/faixas) no
  // lugar da estratégia por bairro. Default false: lojas existentes continuam
  // exatamente no fluxo de bairro, sem qualquer mudança de comportamento.
  calcularEntregaPorDistancia Boolean    @default(false) @map("calcular_entrega_por_distancia")
  criadoEm                    DateTime   @default(now()) @map("criado_em")

  usuarios                      Usuario[]
  categorias                    Categoria[]
  produtos                      Produto[]
  pedidos                       Pedido[]
  bairrosEntrega                BairroEntrega[]
  faixasEntregaDistancia        FaixaEntregaDistancia[]
  onboarding                    OnboardingLoja?
  rascunhosCardapio             RascunhoCardapio[]
  solicitacoesCardapioAssistido SolicitacaoCardapioAssistido[]
  sugestoesLojistas             SugestaoLojista[]

  @@map("lojas")
}

// Estado da implantação guiada pós-ativação — 1:1 com Loja. Lojas que já
// existiam antes desta feature são retroativamente marcadas como
// 'concluido' por um script de backfill (prisma/backfillOnboardingExistente.ts),
// nunca pela migration em si, pra não depender de função de UUID específica
// do banco. Lojas novas ganham a linha já na criação (admin-master), com
// status 'nao_iniciado' — o wizard só aparece após o dono ativar a conta.
model OnboardingLoja {
  id               String           @id @default(uuid())
  lojaId           String           @unique @map("loja_id")
  loja             Loja             @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  status           StatusOnboarding @default(nao_iniciado)
  segmentoNegocio  String?          @map("segmento_negocio")
  etapaAtual       String?          @map("etapa_atual")
  // Array de chaves de etapa já concluídas (string[]) — não é enum pra não
  // exigir migration toda vez que uma etapa nova entra no wizard.
  etapasConcluidas Json?            @map("etapas_concluidas")
  metodoCardapio   String?          @map("metodo_cardapio")
  iniciadoEm       DateTime?        @map("iniciado_em")
  concluidoEm      DateTime?        @map("concluido_em")
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em")

  @@map("onboarding_lojas")
}

// Cardápio importado (planilha ou texto colado) fica aqui até o lojista
// revisar e publicar — nunca vira Categoria/Produto real sozinho.
model RascunhoCardapio {
  id          String         @id @default(uuid())
  lojaId      String         @map("loja_id")
  loja        Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  origem      OrigemRascunho
  status      StatusRascunho @default(rascunho)
  criadoEm    DateTime       @default(now()) @map("criado_em")
  publicadoEm DateTime?      @map("publicado_em")

  categorias RascunhoCategoria[]
  produtos   RascunhoProduto[]

  @@map("rascunhos_cardapio")
}

model RascunhoCategoria {
  id         String           @id @default(uuid())
  rascunhoId String           @map("rascunho_id")
  rascunho   RascunhoCardapio @relation(fields: [rascunhoId], references: [id], onDelete: Cascade)
  nome       String
  ordem      Int              @default(0)

  produtos RascunhoProduto[]

  @@map("rascunho_categorias")
}

model RascunhoProduto {
  id                  String             @id @default(uuid())
  rascunhoId          String             @map("rascunho_id")
  rascunho            RascunhoCardapio   @relation(fields: [rascunhoId], references: [id], onDelete: Cascade)
  rascunhoCategoriaId String?            @map("rascunho_categoria_id")
  rascunhoCategoria   RascunhoCategoria? @relation(fields: [rascunhoCategoriaId], references: [id], onDelete: SetNull)
  nome                String?
  descricao           String?
  // Valor bruto como veio da planilha/texto (ex: "R$ 8,00", "oito reais") —
  // preenchido quando `preco` não pôde ser interpretado com segurança.
  precoTexto          String?            @map("preco_texto")
  preco               Decimal?           @db.Decimal(10, 2)
  disponivel          Boolean            @default(true)
  fotoUrl             String?            @map("foto_url")
  precisaRevisao      Boolean            @default(false) @map("precisa_revisao")
  motivosRevisao      Json?              @map("motivos_revisao")
  possivelDuplicado   Boolean            @default(false) @map("possivel_duplicado")
  // Publicação é por item — um produto sem nome/preço válido nunca bloqueia
  // os demais. `produtoRealId` evita publicar o mesmo item duas vezes se o
  // endpoint de publicar for chamado de novo após corrigir outros itens.
  publicado           Boolean            @default(false)
  produtoRealId       String?            @map("produto_real_id")
  ordem               Int                @default(0)

  @@map("rascunho_produtos")
}

// PDF/imagem enviados pelo lojista quando ele não quer montar o cardápio
// sozinho — vira uma fila de revisão humana no Admin Master. O arquivo NUNCA
// é público (diferente das fotos de produto): fica em storage privado e só é
// servido via endpoint autenticado do Admin Master.
model SolicitacaoCardapioAssistido {
  id                  String                    @id @default(uuid())
  lojaId              String                    @map("loja_id")
  loja                Loja                      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  origem              OrigemSolicitacaoCardapio
  arquivoStorageKey   String                    @map("arquivo_storage_key")
  nomeArquivoOriginal String                    @map("nome_arquivo_original")
  mimetype            String
  status              StatusSolicitacaoCardapio @default(recebido)
  criadoEm            DateTime                  @default(now()) @map("criado_em")
  atualizadoEm        DateTime                  @updatedAt @map("atualizado_em")

  @@map("solicitacoes_cardapio_assistido")
}

model SugestaoLojista {
  id        String            @id @default(uuid())
  lojaId    String            @map("loja_id")
  loja      Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  usuarioId String?           @map("usuario_id")
  categoria CategoriaSugestao
  mensagem  String
  status    StatusSugestao    @default(nova)
  criadoEm  DateTime          @default(now()) @map("criado_em")

  @@map("sugestoes_lojistas")
}

model Categoria {
  id     String @id @default(uuid())
  lojaId String @map("loja_id")
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome   String
  ordem  Int    @default(0)

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id          String    @id @default(uuid())
  lojaId      String    @map("loja_id")
  loja        Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  categoriaId String    @map("categoria_id")
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nome        String
  descricao   String?
  preco       Decimal   @db.Decimal(10, 2)
  fotoUrl     String?   @map("foto_url")
  disponivel  Boolean   @default(true)
  opcoes      Json?
  // Posição dentro da categoria (0 = primeiro) — escopo é por categoriaId,
  // não global. Define a ordem no painel e no cardápio público.
  ordem       Int       @default(0)
  criadoEm    DateTime  @default(now()) @map("criado_em")

  @@map("produtos")
}

model Pedido {
  id                     String    @id @default(uuid())
  lojaId                 String    @map("loja_id")
  loja                   Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  numero                 Int       @default(0)
  clienteNome            String    @default("") @map("cliente_nome")
  clienteTelefone        String    @map("cliente_telefone")
  itens                  Json
  formaRecebimento       String    @default("retirada") @map("forma_recebimento")
  bairroEntregaId        String?   @map("bairro_entrega_id")
  bairroEntregaNome      String?   @map("bairro_entrega_nome")
  valorEntrega           Decimal   @default(0) @map("valor_entrega") @db.Decimal(10, 2)
  formaPagamento         String    @default("nao_informado") @map("forma_pagamento")
  precisaTroco           Boolean?  @map("precisa_troco")
  trocoPara              Decimal?  @map("troco_para") @db.Decimal(10, 2)
  tipoCartao             String?   @map("tipo_cartao")
  entregaCep             String?   @map("entrega_cep")
  entregaLogradouro      String?   @map("entrega_logradouro")
  entregaNumero          String?   @map("entrega_numero")
  entregaComplemento     String?   @map("entrega_complemento")
  entregaBairro          String?   @map("entrega_bairro")
  entregaCidade          String?   @map("entrega_cidade")
  entregaEstado          String?   @map("entrega_estado")
  entregaReferencia      String?   @map("entrega_referencia")
  status                 String    @default("recebido")
  motivoCancelamento     String?   @map("motivo_cancelamento")
  tipoPedido             String    @default("imediato") @map("tipo_pedido")
  dataAgendamento        DateTime? @map("data_agendamento")
  total                  Decimal   @db.Decimal(10, 2)
  // Snapshot de como a taxa por distância foi calculada nesse pedido — só
  // preenchidos quando formaRecebimento é entrega e a loja usa esse modo.
  // Faixas futuras da loja nunca recalculam um pedido já criado.
  clienteLatitude        Float?    @map("cliente_latitude")
  clienteLongitude       Float?    @map("cliente_longitude")
  entregaDistanciaMetros Int?      @map("entrega_distancia_metros")
  criadoEm               DateTime  @default(now()) @map("criado_em")

  @@map("pedidos")
}

model BairroEntrega {
  id           String   @id @default(uuid())
  lojaId       String   @map("loja_id")
  loja         Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nomeBairro   String   @map("nome_bairro")
  valorEntrega Decimal  @map("valor_entrega") @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("bairros_entrega")
}

// Faixas de "até X metros -> R$ Y" configuradas pela loja quando
// calcularEntregaPorDistancia está ligado. Distância é sempre aproximada em
// linha reta (Haversine) — ver backend/src/utils/distancia.ts.
model FaixaEntregaDistancia {
  id                 String   @id @default(uuid())
  lojaId             String   @map("loja_id")
  loja               Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  distanciaMaxMetros Int      @map("distancia_max_metros")
  valorEntrega       Decimal  @map("valor_entrega") @db.Decimal(10, 2)
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now()) @map("criado_em")

  @@map("faixas_entrega_distancia")
}
